# Virtual Environments (Anywhere in the tree)
**/venv/
**/.venv/
**/env/
**/bin/
**/Include/
**/Lib/
**/Scripts/
**/share/
**/pyvenv.cfg

# Python Cache
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.pytest_cache/

# Node/Expo (Anywhere in the tree)
**/node_modules/
**/.expo/
**/dist/
**/.next/
**/.vercel/

# Logs
**/*.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS/IDEs
.DS_Store
.idea/
.vscode/
Thumbs.db
*.swp
*.swo

# Project Specific
React_app/MyApp/web-build/
React_app/MyApp/android/build/
React_app/MyApp/ios/build/

# Secret / Environment Files
**/.env*
**/.env.local
**/.env.development
**/.env.test
**/.env.production

# Databases
**/*.db
**/*.db-journal
**/*.db-shm
**/*.db-wal